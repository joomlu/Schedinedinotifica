+diff --git a/app/Services/WebCheckinLink.php b/app/Services/WebCheckinLink.php
+new file mode 100644
+index 0000000000000000000000000000000000000000..b5741ec1abf22d87c2e3296d5b8b5f537d7e3b67
+--- /dev/null
