+                $b['valida_dal'] = '2027-01-01';
+                $b['valida_al'] = '2027-12-31';
+                $b['inizio'] = '2027-01-01';
+                $b['fine'] = '2027-01-31';
+                $b['regola_versione'] = 'SINTETICO-2027-INVERNALE';
+                $b['regola_fonte'] = 'Fixture, nessuna fonte normativa';
+                $b['tariffe'][3] = '3.00';
+
+                return [$a, $b];
