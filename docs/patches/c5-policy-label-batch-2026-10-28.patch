+def receiver_labels_for(paths):
+    # Stesse interrogazioni della policy per tutti i percorsi, a gruppi limitati.
+    # Nessuna cache: ogni fase ripete la lettura e i controlli del contenitore.
+    paths = [Path(path) for path in paths]
+    result = {}
+    for offset in range(0, len(paths), 128):
+        batch = paths[offset:offset + 128]
+        p = subprocess.run(['matchpathcon', '-n', *map(str, batch)],
+                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=10)
+        require(p.returncode == 0, 'Policy ricevente non leggibile')
+        contexts = p.stdout.splitlines()
+        require(len(contexts) == len(batch), 'Risposta policy ricevente incompleta')
+        for path, context in zip(batch, contexts):
+            context = context.strip()
+            if context == b'<<none>>':
+                parent = path.parent
+                while not parent.exists():
+                    parent = parent.parent
+                require(not parent.is_symlink() and parent.is_dir(), 'Contenitore label non sicuro')
+                context = os.getxattr(parent, 'security.selinux', follow_symlinks=False)
+            else:
+                context += b'\x00'
+            require(context.count(b':') >= 3 and context != b'<<none>>', 'Contesto non valido')
+            result[str(path)] = context.hex()
+    return result
+
