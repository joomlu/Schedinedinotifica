# Production template. Set secrets privately; never commit .env.
APP_NAME="Schedine di Notifica"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://schedinedinotifica.tanggo.software
ASSET_URL=

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Leave blank: do not copy the Herd socket.
DB_SOCKET=

BROADCAST_DRIVER=null
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=schedinedinotifica_session
SANCTUM_STATEFUL_DOMAINS=schedinedinotifica.tanggo.software

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

QA_ENABLED=false
UI_CSS_FALLBACK=false
CAMERE_REALI_ENABLED=false
CAMERE_REALI_STRUTTURE=
VITE_APP_NAME="${APP_NAME}"

# Optional alternative backends / overrides (enable only when configured).
# ABLY_KEY=
